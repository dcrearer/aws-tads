## Linux-native build of all workspace Lambda binaries.
## Routes around the macOS zig cross-compile failure (aws-lc-sys/ring) by building
## natively on Linux inside the official cargo-lambda image. See README "Deployment".
FROM ghcr.io/cargo-lambda/cargo-lambda:latest AS builder
WORKDIR /src

# Copy the workspace (target/, cdk/.venv, .git excluded via .containerignore).
COPY . .

# One build at the workspace root compiles every `[[bin]]` into target/lambda/<name>/bootstrap.
# `-j 2` caps parallel rustc jobs: release+LTO links are memory-heavy and OOM-kill on a
# small container/VM if too many run at once.
RUN cargo lambda build --release --arm64 -j 2

FROM scratch
COPY --from=builder /src/target/lambda /lambda
