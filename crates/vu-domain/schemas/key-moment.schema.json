{
  "$defs": {
    "provenance": {
      "additionalProperties": false,
      "properties": {
        "generated_at": {
          "format": "date-time",
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "model_version": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    },
    "description": {
      "type": "string"
    },
    "evidence": {
      "description": "supporting signals/quotes the model cited",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "title": {
      "minLength": 1,
      "type": "string"
    },
    "type": {
      "enum": [
        "notable_event",
        "speaker_change",
        "highlight",
        "scene_cut",
        "text_on_screen"
      ],
      "type": "string"
    }
  },
  "required": [
    "title",
    "type",
    "confidence"
  ],
  "title": "VU Key Moment",
  "type": "object"
}
